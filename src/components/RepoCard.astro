---
import GithubMark from './GithubMark.astro';
import { repoName, LANG_COLORS } from '../lib/site';

interface Props { github: string; languages?: string[] }
const { github, languages = [] } = Astro.props;
const full = repoName(github);
const [owner, ...rest] = full.split('/');
const repo = rest.join('/');
const clone = `git clone https://github.com/${full}`;
---
<div class="repo-card">
  <div class="inner">
    <span class="sweep" aria-hidden="true"></span>
    <div class="head">
      <div class="who">
        <span class="mark"><GithubMark size={28} fill="#06080a" /></span>
        <div>
          <div class="mono label">SOURCE ON GITHUB</div>
          <div class="mono name"><span>{owner} /</span> {repo}</div>
        </div>
      </div>
      <span class="mono live"><i></i>PUBLIC</span>
    </div>
    {languages.length > 0 && (
      <div class="langs mono">
        {languages.map((l) => <span><i style={`background:${LANG_COLORS[l] ?? '#8E9994'}`}></i>{l}</span>)}
      </div>
    )}
    <div class="clone">
      <code class="mono"><span>$</span> {clone}</code>
      <button type="button" class="mono copy" data-copy={clone} aria-label="Copy clone command">Copy</button>
    </div>
    <a class="btn btn-light open" href={github}>Open repository
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 10L10 4M5 4h5v5"></path></svg>
    </a>
  </div>
</div>

<style>
  .repo-card {
    position: relative; border-radius: 28px; padding: 1px;
    background: linear-gradient(140deg, rgba(134, 224, 184, 0.7), rgba(255, 255, 255, 0.08) 40%, rgba(255, 184, 112, 0.55));
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5), 0 0 60px rgba(134, 224, 184, 0.12);
  }
  .inner { position: relative; overflow: hidden; border-radius: 27px; padding: 26px; background: rgba(12, 16, 18, 0.9); backdrop-filter: blur(24px) saturate(160%); -webkit-backdrop-filter: blur(24px) saturate(160%); }
  .sweep { position: absolute; top: -40%; left: 0; width: 90px; height: 180%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.09), transparent); animation: sweep 6s ease-in-out infinite; pointer-events: none; }
  @keyframes sweep { 0% { transform: translateX(-120%) rotate(18deg); } 60%, 100% { transform: translateX(520%) rotate(18deg); } }
  .head { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .who { display: flex; align-items: center; gap: 14px; min-width: 0; }
  .mark { flex: none; width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: var(--fg); }
  .label { font-size: 11px; letter-spacing: 0.12em; color: #95a19b; }
  .name { margin-top: 4px; font-size: 17px; overflow-wrap: anywhere; }
  .name span { color: var(--fg-3); }
  .live { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--jade); }
  .live i { width: 8px; height: 8px; border-radius: 50%; background: var(--jade); box-shadow: 0 0 10px var(--jade); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
  .langs { position: relative; margin-top: 20px; display: flex; flex-wrap: wrap; gap: 16px; font-size: 12px; color: var(--fg-2); }
  .langs span { display: flex; align-items: center; gap: 7px; }
  .langs i { width: 10px; height: 10px; border-radius: 50%; }
  .clone { position: relative; margin-top: 20px; display: flex; align-items: center; gap: 10px; padding: 6px 6px 6px 16px; border-radius: 14px; background: rgba(0, 0, 0, 0.45); border: 1px solid rgba(255, 255, 255, 0.1); }
  .clone code { flex: 1; min-width: 0; font-size: 12.5px; color: var(--fg-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .clone code span { color: var(--jade); }
  .copy { min-width: 76px; height: 40px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.06); color: var(--fg); font-size: 12px; cursor: pointer; }
  .open { position: relative; margin-top: 14px; width: 100%; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.repo-card .copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; }
    catch { b.textContent = 'Press ⌘C'; }
    setTimeout(() => { b.textContent = 'Copy'; }, 1600);
  }));
</script>
