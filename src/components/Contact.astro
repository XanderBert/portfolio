---
import site from '../data/site.json';
---
<section id="contact" class="contact glass wrap-inner">
  <div>
    <h2 class="serif">Let’s talk <em>light.</em></h2>
    <p>Open to graphics and rendering roles. The best way to reach me is email.</p>
  </div>
  <div class="right">
    {site.email && <a class="mail mono" href={`mailto:${site.email}`}>{site.email}</a>}
    <div class="row">
      {site.github && <a class="btn btn-glass" href={site.github}>GitHub</a>}
      {site.linkedin && <a class="btn btn-glass" href={site.linkedin}>LinkedIn</a>}
      {site.blog && <a class="btn btn-glass" href={site.blog}>Blog</a>}
      {site.resume && <a class="btn btn-light" href={site.resume}>Résumé</a>}
    </div>
  </div>
</section>

<style>
  .contact {
    margin: clamp(80px, 12vw, 160px) var(--gutter) 0; padding: clamp(28px, 5vw, 64px); border-radius: 32px;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; align-items: end;
    max-width: calc(1440px - 2 * 80px);
  }
  @media (min-width: 1440px) { .contact { margin-inline: auto; } }
  h2 { margin: 0; font-size: clamp(52px, 7vw, 88px); line-height: 0.92; }
  p { margin: 20px 0 0; color: var(--fg-2); font-size: 18px; }
  .right { display: flex; flex-direction: column; gap: 14px; align-items: flex-end; }
  .mail { font-size: clamp(16px, 2vw, 20px); overflow-wrap: anywhere; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
  .row .btn { min-height: 48px; }
  @media (max-width: 760px) {
    .contact { grid-template-columns: 1fr; }
    .right, .row { align-items: flex-start; justify-content: flex-start; }
  }
</style>
