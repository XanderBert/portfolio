---
// The horizontal 3D card carousel. Rendered on the home page (after the hero)
// and on /work/. The page that hosts it drives it from scroll via src/scripts/deck.ts.
import GithubMark from './GithubMark.astro';
import { getWorks, url, CATEGORIES, repoName, type Category } from '../lib/site';

interface Props { eyebrow?: string; title?: string; titleEm?: string; allLink?: boolean; headingLevel?: 'h1' | 'h2' }
const { eyebrow = 'Selected work', title = 'Things I built to', titleEm = 'understand light.', allLink = false, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;

const works = await getWorks();
const items = works.map((w) => {
  const cat = CATEGORIES[w.data.categories[0] as Category];
  return {
    id: w.id,
    href: url(`work/${w.id}/`),
    title: w.data.title,
    year: String(w.data.date.getFullYear()),
    cats: w.data.categories,
    catLabel: cat.label.toUpperCase(),
    color: cat.color,
    tags: w.data.tags.slice(0, 3).join(' · '),
    summary: w.data.summary,
    cover: w.data.cover,
    github: w.data.github,
    repo: w.data.github ? repoName(w.data.github) : '',
  };
});
const used = new Set(works.flatMap((w) => w.data.categories));
const chips = [{ id: 'all', label: 'All' }, ...Object.entries(CATEGORIES).filter(([k]) => used.has(k as Category)).map(([id, c]) => ({ id, label: c.label }))];
---
<div class="deck-ui">
  <div class="deck-top wrap">
    <div>
      <div class="eyebrow">{eyebrow}</div>
      <H class="serif deck-title">{`${title} `}<em>{titleEm}</em></H>
    </div>
    <div class="chips glass" role="group" aria-label="Filter by category">
      {chips.map((c, i) => <button type="button" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>)}
    </div>
  </div>

  <div class="ring">
    {items.map((it, i) => (
      <a class="card glass" href={it.href} data-cats={it.cats.join(' ')} style={`--c:${it.color}`}>
        <span class="thumb">
          {it.cover
            ? <img src={it.cover} alt="" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
            : <span class="ph serif">{it.title}</span>}
          <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
          {it.github && <span class="gh" title={it.repo}><GithubMark size={15} /></span>}
        </span>
        <span class="body">
          <span class="cat mono">{it.catLabel} · {it.year}</span>
          <span class="t serif">{it.title}</span>
          <span class="sum">{it.summary}</span>
          <span class="foot mono"><span>{it.tags}</span><span class="more">Read more →</span></span>
        </span>
      </a>
    ))}
  </div>

  <div class="controls">
    <button type="button" class="arrow" data-prev aria-label="Previous project"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg></button>
    <span class="mono count" data-count aria-live="polite">01 / {String(items.length).padStart(2, '0')}</span>
    <button type="button" class="arrow" data-next aria-label="Next project"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3l5 5-5 5"></path></svg></button>
    {allLink && <a class="all mono" href={url('work/')}>ALL WORK →</a>}
  </div>
</div>

<style>
  .deck-ui { position: absolute; inset: 0; }
  .deck-top { position: absolute; left: 0; right: 0; top: 104px; display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; z-index: 5; }
  .deck-title { margin: 10px 0 0; font-size: clamp(36px, 3.6vw, 56px); line-height: 1; font-weight: 400; }
  .chips { display: flex; flex-wrap: nowrap; gap: 4px; padding: 6px; border-radius: 18px; }
  .chips button { white-space: nowrap; min-height: 44px; padding: 0 14px; border: 0; border-radius: 13px; cursor: pointer; background: transparent; color: var(--fg-2); font: 500 14px var(--sans); }
  .chips button[aria-pressed='true'] { background: var(--fg); color: #06080a; }

  .ring { position: absolute; left: 0; right: 0; top: 200px; bottom: 96px; perspective: 1800px; perspective-origin: 50% 45%; }
  .card {
    --w: clamp(320px, 36vw, 540px);
    position: absolute; left: calc(50% - var(--w) / 2); top: 50%; width: var(--w);
    translate: 0 -50%;
    padding: 14px; border-radius: 28px; display: flex; flex-direction: column;
    color: var(--fg); text-decoration: none; background: rgba(255, 255, 255, 0.06);
    will-change: transform, opacity;
  }
  .card:hover { color: var(--fg); }
  .card.on { border-color: color-mix(in srgb, var(--c) 70%, transparent); box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 40px 120px rgba(0,0,0,.55), 0 0 60px color-mix(in srgb, var(--c) 18%, transparent); }
  .thumb {
    position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.08);
    background: radial-gradient(120% 90% at 30% 20%, color-mix(in srgb, var(--c) 40%, transparent), rgba(6, 8, 10, 0.92) 70%);
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .card.on:hover .thumb img { transform: scale(1.03); }
  .ph { position: absolute; left: 20px; right: 20px; bottom: 16px; font-size: 30px; line-height: 1; color: rgba(238, 242, 239, 0.4); }
  .num, .gh { position: absolute; top: 12px; padding: 4px 9px; border-radius: 9px; background: rgba(0, 0, 0, 0.5); font-size: 12px; backdrop-filter: blur(8px); }
  .num { left: 12px; }
  .gh { right: 12px; display: grid; place-items: center; }
  .body { display: flex; flex-direction: column; gap: 10px; padding: 18px 10px 8px; }
  .cat { font-size: 11px; letter-spacing: 0.12em; color: var(--c); }
  .t { font-size: clamp(28px, 2.4vw, 38px); line-height: 1.02; }
  .sum { font-size: 15px; line-height: 1.55; color: var(--fg-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { margin-top: 4px; display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--fg-3); }
  .more { color: var(--c); white-space: nowrap; opacity: 0; transition: opacity .3s ease; }
  .card.on .more { opacity: 1; }

  .controls { position: absolute; left: 0; right: 0; bottom: 28px; display: flex; align-items: center; justify-content: center; gap: 12px; z-index: 5; }
  .arrow { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; cursor: pointer; color: var(--fg); background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.16); backdrop-filter: blur(12px); }
  .arrow:hover { border-color: rgba(255, 255, 255, 0.35); }
  .count { min-width: 72px; text-align: center; font-size: 13px; color: var(--fg-2); }
  .all { position: absolute; right: clamp(16px, 5.5vw, 80px); font-size: 13px; letter-spacing: 0.12em; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }

  @media (max-width: 900px) {
    .deck-top { flex-direction: column; align-items: flex-start; gap: 14px; top: 88px; }
    .chips { overflow-x: auto; max-width: 100%; scrollbar-width: none; }
    .chips button { min-height: 40px; padding: 0 12px; font-size: 13px; }
    .ring { top: 230px; bottom: 150px; }
    .card { --w: min(82vw, 420px); padding: 10px; }
    .body { padding: 14px 6px 6px; gap: 8px; }
    .t { font-size: 26px; }
    .sum { font-size: 14px; }
    .controls { bottom: 92px; }
    .all { display: none; }
  }
  @media (max-width: 900px) and (max-height: 720px) { .sum { display: none; } }
</style>
